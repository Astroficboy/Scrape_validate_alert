# Copy this file to .env for local runs. In GitHub Actions, set these as
# repository secrets instead (Settings -> Secrets and variables -> Actions).
# Nothing in this file is read unless the corresponding secret/env var is set;
# missing credentials just disable that one source/channel (logged, not fatal).

# --- Job source: Adzuna (free API — https://developer.adzuna.com/) ---
# NOTE: Adzuna does not cover the UAE market (confirmed via live 404s on
# country code "ae") — disabled by default in config.yaml. Left here in case
# Adzuna adds MENA coverage later.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Job source: Google Custom Search (free tier, 100 queries/day) ---
# https://developers.google.com/custom-search/v1/introduction
# 1. Enable "Custom Search API" in a Google Cloud project, create an API key.
# 2. Create a Programmable Search Engine at https://programmablesearchengine.google.com/
#    set to "Search the entire web", copy its Search engine ID.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Email channel (Gmail SMTP with an App Password) ---
# Create at https://myaccount.google.com/apppasswords (requires 2FA enabled)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_TO=pranavwankhedkar@gmail.com

# --- WhatsApp channel (Twilio WhatsApp API) ---
# https://www.twilio.com/docs/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox default is whatsapp:+14155238886; use your approved sender in production
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+918087595673
# Optional: Content Template SID for messaging outside the 24h session window
# (required for unattended daily sends once you leave the Twilio sandbox)
TWILIO_CONTENT_SID=
